<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="350.0" prefWidth="380.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.empleadosjfx.viewController.InicioSesionViewController">
   <children>
      <Text fill="#1a5276" layoutX="70.0" layoutY="45.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nómina y Empleados">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Text>
      <Separator layoutX="30.0" layoutY="65.0" prefWidth="320.0" />
      <Text fill="#2c3e50" layoutX="70.0" layoutY="110.0" text="Usuario:">
         <font><Font size="15.0" /></font>
      </Text>
      <TextField fx:id="txtUsuario" layoutX="70.0" layoutY="125.0" prefHeight="30.0" prefWidth="240.0" promptText="Ingresar usuario" />
      <Text fill="#2c3e50" layoutX="70.0" layoutY="185.0" text="Contraseña:">
         <font><Font size="15.0" /></font>
      </Text>
      <PasswordField fx:id="txtPassword" layoutX="70.0" layoutY="200.0" prefHeight="30.0" prefWidth="240.0" promptText="Ingresar contraseña" />
      <Button layoutX="70.0" layoutY="265.0" mnemonicParsing="false" onAction="#onLogin" prefHeight="35.0" prefWidth="240.0" text="Iniciar Sesión" textFill="#1a5276">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
