<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.empleadosjfx.viewController.EmpleadoViewController">
    <children>
        <SplitPane dividerPositions="0.52" orientation="VERTICAL" prefHeight="600.0" prefWidth="550.0">
            <items>
                <AnchorPane minHeight="0.0" minWidth="0.0">
                    <children>
                        <Pane layoutX="15.0" layoutY="5.0" prefHeight="290.0" prefWidth="520.0">
                            <children>
                                <Label layoutX="160.0" layoutY="5.0" text="Gestión de Empleados" textFill="#1a5276">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <Label layoutX="20.0" layoutY="40.0" text="ID:" />
                                <TextField fx:id="txtId" layoutX="110.0" layoutY="35.0" prefWidth="130.0" />

                                <Label layoutX="260.0" layoutY="40.0" text="Nombre:" />
                                <TextField fx:id="txtNombre" layoutX="330.0" layoutY="35.0" prefWidth="170.0" />

                                <Label layoutX="20.0" layoutY="80.0" text="Tipo Empleado:" />
                                <ComboBox fx:id="cbTipoEmpleado" layoutX="110.0" layoutY="75.0" prefWidth="130.0" />

                                <Label layoutX="260.0" layoutY="80.0" text="Categoría:" />
                                <ComboBox fx:id="cbCategoria" layoutX="330.0" layoutY="75.0" prefWidth="170.0" />

                                <Label fx:id="lblCampo1" layoutX="20.0" layoutY="120.0" text="Salario Base:" />
                                <TextField fx:id="txtCampo1" layoutX="110.0" layoutY="115.0" prefWidth="130.0" />

                                <Label fx:id="lblCampo2" layoutX="260.0" layoutY="120.0" text="Bonificación:" />
                                <TextField fx:id="txtCampo2" layoutX="330.0" layoutY="115.0" prefWidth="170.0" />

                                <Button layoutX="30.0" layoutY="175.0" onAction="#onAgregarEmpleado" prefWidth="90.0" text="Agregar" />
                                <Button layoutX="135.0" layoutY="175.0" onAction="#onActualizarEmpleado" prefWidth="90.0" text="Actualizar" />
                                <Button layoutX="240.0" layoutY="175.0" onAction="#onLimpiar" prefWidth="90.0" text="Limpiar" />
                                <Button layoutX="345.0" layoutY="175.0" onAction="#onVolver" prefWidth="90.0" text="Volver" />

                                <Label fx:id="lblTotalNomina" layoutX="20.0" layoutY="230.0" text="Costo Total Nómina: $0.00" textFill="#27ae60">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                            </children>
                        </Pane>
                    </children>
                </AnchorPane>
                <AnchorPane minHeight="0.0" minWidth="0.0">
                    <children>
                        <TableView fx:id="tblListEmpleado" layoutX="10.0" layoutY="10.0" prefHeight="220.0" prefWidth="530.0">
                            <columns>
                                <TableColumn fx:id="tbcId" prefWidth="75.0" text="ID" />
                                <TableColumn fx:id="tbcNombre" prefWidth="130.0" text="Nombre" />
                                <TableColumn fx:id="tbcTipo" prefWidth="100.0" text="Tipo" />
                                <TableColumn fx:id="tbcCategoria" prefWidth="90.0" text="Categoría" />
                                <TableColumn fx:id="tbcSalarioTotal" prefWidth="130.0" text="Total a Pagar ($)" />
                            </columns>
                        </TableView>
                        <Button layoutX="230.0" layoutY="240.0" onAction="#onEliminar" prefWidth="90.0" text="Eliminar" textFill="#922b21" />
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>
