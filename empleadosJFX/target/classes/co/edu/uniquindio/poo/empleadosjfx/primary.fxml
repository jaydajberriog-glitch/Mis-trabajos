<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="400.0" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.empleadosjfx.viewController.PrimaryController">
    <children>
        <Label text="Sistema de Gestión de Nómina" textFill="#1a5276">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
        </Label>
        <Button onAction="#onOpenCrudEmpleado" prefHeight="45.0" prefWidth="250.0" text="Gestión de Empleados y Pagos">
         <font>
            <Font size="14.0" />
         </font>
        </Button>
        <Button onAction="#onCerrarSesion" prefHeight="32.0" prefWidth="150.0" text="Cerrar Sesión" textFill="#922b21">
         <font>
            <Font size="12.0" />
         </font>
        </Button>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
