<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="viewcontrollers.PanaderiaViewController"
            prefWidth="1100.0" prefHeight="720.0">

    <top>
        <VBox spacing="5.0" style="-fx-background-color: #183D2B;">
            <padding>
                <Insets top="22.0" right="25.0" bottom="22.0" left="25.0"/>
            </padding>
            <Label text="PANADERÍA EL TRIGAL"
                   style="-fx-text-fill: #F6F0E4; -fx-font-size: 25px; -fx-font-weight: bold;"/>
            <Label text="Gestión de pedidos y producción"
                   style="-fx-text-fill: #D9C99E; -fx-font-size: 13px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="16.0">
            <padding>
                <Insets top="20.0" right="25.0" bottom="20.0" left="25.0"/>
            </padding>

            <VBox spacing="10.0"
                  style="-fx-background-color: white; -fx-background-radius: 9px; -fx-border-color: #DDD8CC; -fx-border-radius: 9px;">
                <padding>
                    <Insets top="15.0" right="16.0" bottom="15.0" left="16.0"/>
                </padding>
                <Label text="REGISTRO Y GESTIÓN DE PEDIDOS"
                       style="-fx-text-fill: #183D2B; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <HBox spacing="10.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Código del pedido"/>
                        <TextField fx:id="txtCodigo" promptText="Ej. PED-001"/>
                    </VBox>
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Nombre del cliente"/>
                        <TextField fx:id="txtCliente" promptText="Nombre de cafetería o restaurante"/>
                    </VBox>
                    <VBox spacing="5.0" prefWidth="170.0">
                        <Label text="Tipo de pan"/>
                        <ComboBox fx:id="cmbTipoPan" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="5.0" prefWidth="120.0">
                        <Label text="Cantidad"/>
                        <TextField fx:id="txtCantidad" promptText="Ej. 24"/>
                    </VBox>
                </HBox>

                <HBox spacing="10.0">
                    <Button text="Registrar pedido" onAction="#onRegistrarPedido"
                            style="-fx-background-color: #183D2B; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Asignar a producción" onAction="#onAsignarPedido"
                            style="-fx-background-color: #C6A45B; -fx-text-fill: #183D2B; -fx-font-weight: bold;"/>
                    <Button text="Cancelar pedido" onAction="#onCancelarPedido"
                            style="-fx-background-color: #8A3D32; -fx-text-fill: white;"/>
                </HBox>
                <Label text="Para asignar o cancelar, escribe el código del pedido en el primer campo."
                       style="-fx-text-fill: #6F6A60; -fx-font-size: 11px;"/>
            </VBox>

            <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                <Label text="PEDIDOS REGISTRADOS"
                       style="-fx-text-fill: #183D2B; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                <TableView fx:id="tblPedidos" prefHeight="230.0" VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                <Label text="EMPLEADOS Y DISPONIBILIDAD"
                       style="-fx-text-fill: #183D2B; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                <TableView fx:id="tblEmpleados" prefHeight="170.0" VBox.vgrow="ALWAYS"/>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <Label text="Java 17  |  JavaFX  |  JUnit 5"
               style="-fx-background-color: #E8E2D5; -fx-text-fill: #526052; -fx-padding: 9px 25px;"/>
    </bottom>
</BorderPane>
